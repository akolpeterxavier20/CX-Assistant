{
  "name": "cx-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --use-system-ca server/server.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "check": "node --check server/server.js && node --check server/routes/chat.js && node --check server/services/aiService.js && node --check server/services/knowledgeService.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
