# Example environment variables for CX Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VITE_API_URL=http://localhost:4000/api/chat
PORT=4000

# Deployment examples (set these in your hosting provider dashboard)
# Backend (Render) - the public URL for your backend API
BACKEND_URL=https://cx-assistant.onrender.com

# Frontend (Vercel) - the public URL for your frontend app
CLIENT_ORIGIN=https://cx-assistant-amber.vercel.app

# Vite production API URL (set this in Vercel as VITE_API_URL)
# e.g. VITE_API_URL=https://cx-assistant.onrender.com/api/chat

