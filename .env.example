# ─────────────────────────────────────────────────────────────
# CX Assistant – Environment Variables
# ─────────────────────────────────────────────────────────────

# ── AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Local development ─────────────────────────────────────────
PORT=4000

# ── CORS – Backend (set on Render / Railway / etc.) ──────────
# Comma-separated list of allowed frontend origins.
# Add your Vercel URL here alongside localhost:
#   CLIENT_ORIGIN=https://cx-assistant-amber.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# ── API URL – Frontend (set on Vercel) ───────────────────────
# Point to your deployed backend URL (NOT localhost):
#   VITE_API_URL=https://cx-assistant.onrender.com/api/chat
VITE_API_URL=http://localhost:4000/api/chat
